# Copy to .env and fill in. Never commit real values.

# --- Required API keys ---
OPENAI_API_KEY=            # dense embeddings + answer/judge LLM
CHROMA_API_KEY=            # Chroma Cloud
CHROMA_TENANT=             # Chroma Cloud tenant id
COHERE_API_KEY=           # reranker

# --- Conversation store ---
# Supabase (or any Postgres). Settings → Database → Connection string, port 5432.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# --- Evaluation (Langfuse) — only needed to run `python -m evaluation.run_evaluation` ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optional overrides (defaults in src/config.py) ---
# CHROMA_DATABASE=production-rag
# COLLECTION_NAME=research_papers_hybrid
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini
# RERANK_MODEL=rerank-v3.5
# RETRIEVAL_K=20
# RERANK_TOP_N=5
# DENSE_WEIGHT=0.6
# SPARSE_WEIGHT=0.4
# RELEVANCE_THRESHOLD=0.3   # min Cohere rerank score; below it the answer is "not in the policies"
