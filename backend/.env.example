# Copy to .env and fill in. Never commit real values.

# --- Required API keys ---
OPENAI_API_KEY=            # dense embeddings + answer/judge LLM
CHROMA_API_KEY=            # Chroma Cloud
CHROMA_TENANT=             # Chroma Cloud tenant id
COHERE_API_KEY=           # reranker

# --- Conversation store ---
# Supabase (or any Postgres). Settings → Database → Connection string, port 5432.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# --- Ingestion corpus source ---
# "local" (default) reads PDFs from backend/docs/. "supabase" pulls them from a
# private Storage bucket. The SHA-256 manifest is in Postgres either way.
DOCS_SOURCE=local
SUPABASE_URL=                       # https://PROJECT.supabase.co  (Storage REST base)
SUPABASE_SERVICE_ROLE_KEY=          # Project Settings → API → service_role. SERVER ONLY.
DOCS_BUCKET=hr-policy-docs          # private bucket holding the policy PDFs
# DOCS_PREFIX=                      # optional subfolder within the bucket

# --- Evaluation (Langfuse) — only needed to run `python -m evaluation.run_evaluation` ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Escalation (human handoff) ---
# "none" (default, logs only) or "slack"
ESCALATION_BACKEND=none
SLACK_WEBHOOK_URL=        # Slack incoming-webhook URL, required when ESCALATION_BACKEND=slack

# --- Optional overrides (defaults in src/config.py) ---
# CHROMA_DATABASE=production-rag
# COLLECTION_NAME=research_papers_hybrid
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini
# RERANK_MODEL=rerank-v3.5
# RETRIEVAL_K=20
# RERANK_TOP_N=5
# DENSE_WEIGHT=0.6
# SPARSE_WEIGHT=0.4
# RELEVANCE_THRESHOLD=0.3   # min Cohere rerank score to answer from the docs
# ESCALATION_FLOOR=0.08     # below RELEVANCE_THRESHOLD but above this -> offer a human handoff
# HISTORY_TURNS=4           # recent messages replayed as follow-up context
